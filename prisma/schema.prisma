// Local Growth Engine — database schema.
// Run `npm run db:migrate` after changing this file, then `npm run db:seed`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
  /// Meta revoked or expired the token (Graph error 190): the user must reconnect.
  NEEDS_RECONNECT
}

/// Which InstagramService implementation serves a connection (lib/services/instagram.ts).
enum InstagramProvider {
  MOCK
  META
}

enum DraftStatus {
  DRAFT
  QUEUED
  PUBLISHED
  REJECTED
}

/// Where a post draft's image came from: AI image generation or the user's own upload.
enum DraftImageSource {
  GENERATED
  UPLOADED
}

enum ScheduledPostStatus {
  SCHEDULED
  /// Claimed by "Publish now" or the publish cron; Instagram calls in progress.
  PUBLISHING
  PUBLISHED
  CANCELLED
  FAILED
}

enum ExperimentStatus {
  RUNNING
  PAUSED
  COMPLETED
}

enum ReplyDraftStatus {
  PENDING
  APPROVED
  DISMISSED
  POSTED
  /// DM drafts only: Instagram's 24-hour reply window closed before it was sent.
  EXPIRED
  /// The comment was deleted (Instagram refused the reply), so it can't be answered any more.
  UNAVAILABLE
}

/// How a sent reply relates to the AI's (or keyword rule's) draft (lib/replies.ts → replyOutcome).
enum ReplyOutcome {
  AS_IS
  EDITED
  MANUAL
}

/// Where an AI reply draft goes: a public reply to a comment, or a direct message.
/// Who set a post's marketing method: the caption rules, the AI, or the client (never overwritten).
enum PostMethodSource {
  RULE
  AI
  USER
}

enum ReplyChannel {
  COMMENT
  DM
}

/// How a keyword reply rule compares its keywords with a comment (lib/keyword-replies.ts).
enum KeywordMatchType {
  /// The keyword appears as a whole word in the comment.
  WORD
  /// The whole comment is the keyword.
  EXACT
}

/// Which posts a keyword reply rule listens to.
enum KeywordRuleScope {
  ALL_POSTS
  SELECTED_POSTS
}

/// What happened to a comment a keyword reply rule picked up.
enum KeywordTriggerStatus {
  /// Being sent right now (the row is the claim that stops a second reply).
  SENDING
  /// Waiting in the Engagement approval queue ("send automatically" off).
  AWAITING_APPROVAL
  /// Everything the rule asked for was sent.
  SENT
  /// Only part of it went out (e.g. the public reply, but not the private DM).
  PARTIAL
  FAILED
  /// The same person triggered this rule within the last 24 hours: nothing sent.
  COOLDOWN
  /// The approval draft was dismissed.
  DISMISSED
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
}

enum BusinessSource {
  ADMIN_CREATED
  SELF_SIGNUP
}

/// Result of InstagramService.lookupBusinessAccount for a competitor handle.
enum CompetitorValidation {
  READY
  NOT_BUSINESS
  PRIVATE
  NOT_FOUND
  OWN_ACCOUNT
}

enum BrandPostSource {
  UPLOAD
  INSTAGRAM
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PostPurpose {
  MENU_PRODUCT
  PROMOTION
  SHOP_LOCATION
  SERVICE
  ANNOUNCEMENT
  BEHIND_THE_SCENES
  OTHER
}

enum BrandContextStatus {
  BUILDING
  READY
  FAILED
}

enum OnboardingEventType {
  STARTED
  COMPLETED
  BACK
  ERROR
  ABANDONED
}

/// What kind of answer the AI assistant gives (the user picks it per question).
enum AssistantMode {
  POST
  ANALYTICS
  COMPETITORS
}

enum AssistantRole {
  USER
  ASSISTANT
}

enum RecommendationTrigger {
  SCHEDULED
  MANUAL
}

enum RecommendationConfidence {
  STRONG
  MODERATE
  EARLY
}

enum RecommendationStatus {
  NEW
  ACCEPTED
  DISMISSED
  DONE
}

/// A post monitor's state: running, ran to its end, stopped by the client, or the post disappeared.
enum MonitorStatus {
  ACTIVE
  ENDED
  STOPPED
  UNAVAILABLE
}

/// How often a monitored post's numbers are read: hourly (up to 3 days) or daily (PostSnapshot).
enum MonitorInterval {
  HOURLY
  DAILY
}

// ─── Accounts ────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  /// Null for admins; every USER manages exactly one business.
  businessId    String?
  /// { sidebarCollapsed: boolean, theme: "light" | "dark" | "system", language: "en" | "ar" }
  uiPreferences Json       @default("{\"sidebarCollapsed\": false, \"theme\": \"system\", \"language\": \"en\"}")
  /// { newComments, approvalNeeded, weeklyReport, competitorAlerts, experimentResults }: booleans
  notificationPrefs Json   @default("{}")
  /// Bumped when the password is reset or changed; sessions carrying an older value are rejected.
  sessionVersion Int       @default(0)
  /// Null until the address is confirmed through the emailed link (self sign-ups).
  emailVerifiedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  lastLoginAt   DateTime?

  business                Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  feedback                Feedback[]
  activity            ActivityLog[]
  postDrafts          PostDraft[]          @relation("DraftAuthor")
  reviewedReplies     ReplyDraft[]         @relation("ReplyReviewer")
  assistantChats      AssistantConversation[]
  notifications       Notification[]

  @@index([businessId])
  @@index([role, status])
}

model Business {
  id              String   @id @default(cuid())
  name            String
  /// Arabic display name (the UI is bilingual).
  nameAr          String?
  /// Null for a self sign-up until it connects Instagram in onboarding.
  instagramHandle String?  @unique
  category        String?
  categoryAr      String?
  location        String
  locationAr      String?
  avatarUrl       String?
  plan            Plan     @default(STARTER)
  timezone        String   @default("Asia/Kuwait")
  createdAt       DateTime @default(now())
  /// Set whenever this business's FeaturePermission rows change; live sessions refresh their feature list.
  permissionsUpdatedAt DateTime @default(now())

  // Onboarding profile (config/onboarding.ts) ---------------------------------
  /// roastery | cafe | restaurant | bakery | sweets | retail | beauty | services | other
  businessType      String?
  businessTypeOther String?
  description       String?
  products          String[]
  targetAudience    String?
  /// Posting languages on Instagram: "ar", "en" or both. Not asked in onboarding — learned
  /// from the captions when the brand profile is built; editable in Settings → Brand profile.
  languages         String[]         @default(["ar", "en"])
  /// Brand basics from onboarding step 5 (tone and words to use live on BrandVoice).
  brandColors       String[]
  logoUrl           String?
  onboardingStatus  OnboardingStatus @default(COMPLETED)
  /// 1–7: instagram, business, competitors, posts, brand, review, result (config/onboarding.ts).
  onboardingStep    Int              @default(1)
  onboardingInvitedAt DateTime?
  /// Set by "Finish later": the app opens while onboarding stays IN_PROGRESS (the dashboard links back).
  onboardingDeferredAt DateTime?
  /// What onboarding's AI pre-fill suggested (niche, tone, hashtags…), kept so it runs once.
  onboardingPrefill Json?

  // Brand focus and goals (onboarding "Confirm your brand" / "Goals"; editable in Settings) ----
  /// Niche / theme in the owner's words, e.g. "Specialty coffee roastery".
  niche          String?
  /// Main aim (config/onboarding.ts BUSINESS_AIMS); null for businesses that haven't set it yet.
  aim            String?
  /// Goals (BUSINESS_GOALS), several allowed.
  goals          String[]  @default([])
  /// GOAL_TIMELINES.
  timeline       String?
  /// One example caption, for new accounts with few posts.
  exampleCaption String?
  /// Existing businesses get a one-time prompt to set niche and goals; set when saved or dismissed.
  goalsPromptDoneAt DateTime?
  source            BusinessSource   @default(ADMIN_CREATED)

  users               User[]
  brandPosts          BrandPost[]
  brandContexts       BrandContext[]
  onboardingEvents    OnboardingEvent[]
  feedback            Feedback[]
  permissions         FeaturePermission[]
  instagramConnection InstagramConnection?
  brandVoice          BrandVoice?
  competitors         Competitor[]
  postDrafts          PostDraft[]
  scheduledPosts      ScheduledPost[]
  experiments         PostingExperiment[]
  engagementRules     EngagementRule[]
  replyDrafts         ReplyDraft[]
  activity            ActivityLog[]
  instagramMedia      InstagramMedia[]
  instagramComments   InstagramMediaComment[]
  accountSnapshots    InstagramAccountSnapshot[]
  integrationEvents   IntegrationEvent[]
  metaPending         MetaPendingConnection?
  directMessages      InstagramDirectMessage[]
  keywordTriggers     KeywordReplyTrigger[]
  assistantChats      AssistantConversation[]
  recommendationRuns  RecommendationRun[]
  recommendations     Recommendation[]
  notifications       Notification[]
  weeklyReports       WeeklyReport[]
  postSnapshots       PostSnapshot[]
  postMethods         PostMethod[]
  postInsights        PostInsight[]
  postMonitors        PostMonitor[]
  statisticsSummaries StatisticsSummary[]
}

/// One row per (business, feature key). A sub-feature ("engagement.dmRules") is
/// only effective when its module ("engagement") is enabled — see lib/permissions.
model FeaturePermission {
  id         String  @id @default(cuid())
  businessId String
  featureKey String
  enabled    Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureKey])
}

model InstagramConnection {
  id                   String           @id @default(cuid())
  businessId           String           @unique
  /// Mock connections only. Meta connections keep the account id inside `credentialsEncrypted`.
  igUserId             String?
  username             String
  /// Mock token. AES-256-GCM ciphertext (lib/crypto.ts). Never returned by the API.
  accessTokenEncrypted String?
  /// When the user must log in again (Meta: the long-lived user token's expiry).
  tokenExpiresAt       DateTime?
  status               ConnectionStatus @default(DISCONNECTED)
  /// When the current connection was made (null while disconnected).
  connectedAt          DateTime?
  lastSyncAt           DateTime?

  provider             InstagramProvider @default(MOCK)
  /// Meta only, AES-256-GCM JSON (lib/server/meta-credentials.ts): user token + expiry, Page id + token,
  /// Instagram business account id, granted scopes. Never returned by the API, never logged.
  credentialsEncrypted String?
  /// HMAC of the Instagram business account id (lib/crypto.ts `lookupKey`): one account → one business.
  igAccountKey         String?          @unique
  /// Meta's data-access window for this login (90 days); shown to admins next to the token expiry.
  dataAccessExpiresAt  DateTime?
  /// Requested permissions the user didn't grant (or that a Graph call reported missing).
  missingPermissions   String[]
  /// Last synced public profile: { name, biography, website, pictureUrl, followers, follows, mediaCount }.
  profile              Json?
  /// Last synced account insights (lib/services/meta/mappers.ts → AccountInsights).
  insights             Json?
  /// Set while a sync runs (stale after 10 minutes) so two syncs don't overlap.
  syncStartedAt        DateTime?
  lastSyncError        String?
  /// Meta only: when the linked Facebook Page was subscribed to this app's messaging webhooks.
  webhookSubscribedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// A post of a Meta-connected account, stored by the sync so pages don't call Meta on every load.
model InstagramMedia {
  id               String   @id @default(cuid())
  businessId       String
  igMediaId        String
  caption          String   @default("")
  /// IMAGE | VIDEO | CAROUSEL_ALBUM
  mediaType        String
  /// FEED | REELS | STORY | AD
  mediaProductType String?
  /// Meta CDN URLs expire after a while; every sync refreshes them.
  mediaUrl         String?
  thumbnailUrl     String?
  permalink        String?
  postedAt         DateTime
  likeCount        Int      @default(0)
  commentsCount    Int      @default(0)
  /// Post insights by metric name (reach, saved, views, shares, total_interactions). A missing key = not available.
  insights         Json     @default("{}")
  syncedAt         DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, igMediaId])
  @@index([businessId, postedAt])
}

/// A comment on one of the account's posts (Meta-connected accounts, refreshed by the sync).
model InstagramMediaComment {
  id          String   @id @default(cuid())
  businessId  String
  igCommentId String
  igMediaId   String
  username    String
  text        String
  likeCount   Int      @default(0)
  postedAt    DateTime
  syncedAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, igCommentId])
  @@index([businessId, postedAt])
}

/// The account's public numbers, one row per day (the latest sync of the day wins) — the real follower history.
model InstagramAccountSnapshot {
  id         String   @id @default(cuid())
  businessId String
  /// YYYY-MM-DD in UTC.
  date       String
  followers  Int
  follows    Int
  mediaCount Int
  takenAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

/// A competitor's public numbers at each refresh (Meta business discovery) — real follower/engagement trends.
model CompetitorSnapshot {
  id             String   @id @default(cuid())
  competitorId   String
  followers      Int
  mediaCount     Int
  /// Percent: average (likes + comments) per recent post ÷ followers.
  engagementRate Float
  takenAt        DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, takenAt])
}

/// Every Meta Graph failure and connection milestone, for admins and lab testing. Never contains tokens.
model IntegrationEvent {
  id         String   @id @default(cuid())
  businessId String?
  provider   String   @default("meta")
  /// error | warning | info
  level      String   @default("error")
  /// What was called, e.g. "GET /{ig-user}/media", "oauth.exchange", "sync".
  call       String
  /// Graph error code (with subcode as "190/463"), or our own code such as "metric_unavailable".
  errorCode  String?
  message    String
  httpStatus Int?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([createdAt])
}

/// A Facebook login that found several Pages with Instagram accounts: kept until the user picks one (15 min).
model MetaPendingConnection {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  userId               String
  /// "onboarding" | "settings"
  returnTo             String
  /// AES-256-GCM JSON: user token + every candidate Page's token. Never sent to the browser.
  credentialsEncrypted String
  /// Non-secret choices for the picker: [{ pageId, pageName, igUserId, username, name, pictureUrl, followers }]
  options              Json
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BrandVoice {
  businessId               String   @id
  /// 0 = formal Arabic … 100 = casual Kuwaiti.
  toneLevel                Int      @default(50)
  defaultHashtags          String[]
  brandWords               String[]
  priceQuestionsToWhatsApp Boolean  @default(false)
  whatsappNumber           String?
  /// Post AI replies without manual approval (feature engagement.autoReply).
  autoReply                Boolean  @default(false)
  /// Words the AI must not use (onboarding brand basics).
  wordsToAvoid             String[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── Content & insights ──────────────────────────────────────────────────────

model Competitor {
  id             String    @id @default(cuid())
  businessId     String
  handle         String
  /// Optional name shown instead of the Instagram profile name.
  displayName    String?
  /// Optional label, e.g. "main rival", "premium segment".
  note           String?
  avatarUrl      String?
  followers      Int       @default(0)
  /// Percent, e.g. 4.2
  engagementRate Float     @default(0)
  lastFetchedAt  DateTime?
  /// Only READY accounts are tracked; the others stay listed in onboarding with the reason.
  validationStatus CompetitorValidation @default(READY)
  lastValidatedAt  DateTime?
  /// Last business-discovery result (Meta-connected businesses), reused for 6 hours.
  profileCache     Json?
  /// Why the last weekly lookup failed (private, not_business, not_found), or null when it worked.
  lookupIssue      String?
  lookupCheckedAt  DateTime?

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]
  analysis  CompetitorAnalysis?

  @@unique([businessId, handle])
}

/// The AI's comparison of a competitor with the business (EN + AR), cached until the measured numbers change.
model CompetitorAnalysis {
  id            String   @id @default(cuid())
  competitorId  String   @unique
  /// Fingerprint of the numbers (both accounts) + prompt version the text was written for.
  inputHash     String
  /// { en: {tactics, theyBetter[], youBetter[], ideas[]}, ar: {…} }, or null when the AI couldn't write it.
  insight       Json?
  failureReason String?
  generatedAt   DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

/// One of the business's posts on one day (daily cron): its metrics over time. Missing metrics are null, never estimated.
model PostSnapshot {
  id         String   @id @default(cuid())
  businessId String
  igMediaId  String
  /// YYYY-MM-DD in UTC.
  date       String
  likes      Int
  comments   Int
  reach      Int?
  saves      Int?
  shares     Int?
  views      Int?
  takenAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, igMediaId, date])
  @@index([businessId, date])
}

/// A post's marketing method (collaboration, giveaway, offer…) and the client's "promoted" flag.
model PostMethod {
  id         String           @id @default(cuid())
  businessId String
  igMediaId  String
  /// lib/analysis/methods.ts → METHODS
  method     String
  source     PostMethodSource
  /// Marked by the client as a paid / boosted post (we have no Ads API).
  promoted   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, igMediaId])
}

/// The AI's short explanation of one post (EN + AR), cached until its numbers change.
model PostInsight {
  id          String   @id @default(cuid())
  businessId  String
  igMediaId   String
  inputHash   String
  /// { en: {summary, learn}, ar: {summary, learn} }
  insight     Json
  generatedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, igMediaId])
}

/// "Monitor this post": the post's numbers are read hourly (short durations) or daily (long ones)
/// until `endsAt`. Hourly readings are MonitorSnapshot rows; daily ones reuse PostSnapshot (one per
/// post per day, shared with Post performance). At the end the numbers are summarised in code and,
/// when the AI is available, in a short EN + AR summary. See lib/server/monitoring.ts.
model PostMonitor {
  id             String          @id @default(cuid())
  businessId     String
  igMediaId      String
  /// The post when monitoring started { caption, format, postedAt, mediaUrl, permalink }, for the history once it leaves the recent posts.
  post           Json            @default("{}")
  /// lib/analysis/monitoring.ts → MONITOR_DURATIONS (the last one chosen, when extended).
  duration       String
  interval       MonitorInterval
  status         MonitorStatus   @default(ACTIVE)
  startedAt      DateTime        @default(now())
  endsAt         DateTime
  endedAt        DateTime?
  /// When the next reading is due (the cron reads monitors whose time has come).
  nextReadingAt  DateTime
  lastReadingAt  DateTime?
  /// Why the last reading failed (e.g. "rate_limited", "not_connected"); cleared by the next success.
  lastError      String?
  /// Notable-change alerts already sent: { "interactions": 2, "reach": 1.5, "below": true }.
  alerts         Json            @default("{}")
  /// The account's averages when monitoring started (the yardstick for alerts and the summary).
  baseline       Json            @default("{}")
  /// Final numbers computed in code when monitoring ends (lib/analysis/monitoring.ts → monitorOutcome).
  outcome        Json?
  /// The AI's short summary { en, ar } of `outcome`; null when the AI was unavailable (numbers only).
  summary        Json?
  /// ok | unavailable | pending
  summaryStatus  String?
  startedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshots MonitorSnapshot[]

  @@index([businessId, status])
  @@index([status, nextReadingAt])
  @@index([businessId, igMediaId])
}

/// One hourly reading of a monitored post. A metric Instagram didn't report is null.
model MonitorSnapshot {
  id        String   @id @default(cuid())
  monitorId String
  takenAt   DateTime @default(now())
  likes     Int
  comments  Int
  reach     Int?
  saves     Int?
  shares    Int?
  views     Int?

  monitor PostMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, takenAt])
}

/// The AI's short summary of a Statistics period (EN + AR), per range ("7d" | "30d" | "90d" | "1y"),
/// cached until the period's numbers change (`inputHash`). The numbers themselves are never stored:
/// they are computed from the follower snapshots and posts on every load (lib/analysis/statistics.ts).
model StatisticsSummary {
  id          String   @id @default(cuid())
  businessId  String
  range       String
  inputHash   String
  /// { en, ar }
  summary     Json
  generatedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, range])
}

// ─── Brand profile ───────────────────────────────────────────────────────────

/// A post the business picked as an example of its content (5 in onboarding).
model BrandPost {
  id           String          @id @default(cuid())
  businessId   String
  source       BrandPostSource
  /// Instagram media id when picked from the connected account.
  igMediaId    String?
  mediaUrl     String?
  mediaType    MediaType       @default(IMAGE)
  caption      String          @default("")
  purpose      PostPurpose
  /// Free text when purpose is OTHER.
  purposeOther String?
  /// "What should this post achieve?"
  purposeNote  String?
  order        Int             @default(0)
  createdAt    DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, order])
}

/// What the AI learned about the brand. Every (re)build is a new version; old ones are kept.
model BrandContext {
  id              String             @id @default(cuid())
  businessId      String
  version         Int
  status          BrandContextStatus @default(BUILDING)
  summary         String             @default("")
  /// { summary: string, traits: string[] }
  visualStyle     Json               @default("{}")
  /// { summary: string, traits: string[], hashtags: string[] }
  captionStyle    Json               @default("{}")
  /// [{ purpose, label, description }]
  purposePatterns Json               @default("[]")
  colors          String[]
  logoUrl         String?
  toneLevel       Int                @default(50)
  wordsToUse      String[]
  wordsToAvoid    String[]
  editedByUser    Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, version])
}

// ─── Onboarding instrumentation ──────────────────────────────────────────────

model OnboardingEvent {
  id         String              @id @default(cuid())
  businessId String
  /// signup | business | instagram | competitors | posts | brand | review | result
  step       String
  event      OnboardingEventType
  details    Json                @default("{}")
  /// Time spent on the step (COMPLETED, BACK, ABANDONED).
  durationMs Int?
  createdAt  DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([step, event])
}

/// "Report a problem" notes from the onboarding wizard.
model Feedback {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  step       String
  note       String
  /// Browser, locale, theme, viewport and a summary of the step's state (no screenshots).
  context    Json     @default("{}")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

/// Platform-wide settings editable by admins (e.g. "selfSignupPlan").
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model PostDraft {
  id         String      @id @default(cuid())
  businessId String
  /// Product category id from the generator (e.g. "nuts").
  category   String
  /// Occasion / angle id (e.g. "new_batch").
  angle      String
  caption    String
  language   String      @default("ar")
  status     DraftStatus @default(DRAFT)
  /// The post's image (StorageService URL): AI-generated or uploaded, never both.
  imageUrl    String?
  imageSource DraftImageSource?
  /// The prompt a GENERATED image was made from (kept for transparency).
  imagePrompt String?
  /// Why the last publish attempt failed (a reason code, see lib/server/publishing.ts); cleared on success.
  publishError String?
  createdBy  String?
  createdAt  DateTime    @default(now())

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author         User?           @relation("DraftAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  scheduledPosts ScheduledPost[]

  @@index([businessId, status, createdAt])
}

model ScheduledPost {
  id               String              @id @default(cuid())
  businessId       String
  draftId          String
  mediaUrl         String?
  scheduledFor     DateTime
  status           ScheduledPostStatus @default(SCHEDULED)
  /// Instagram media id once published.
  publishedMediaId String?
  /// When the current/last publish attempt claimed the post (stale PUBLISHING rows are recovered by the cron).
  publishStartedAt DateTime?
  publishedAt      DateTime?
  /// Reason code when status is FAILED (see lib/server/publishing.ts).
  failureReason    String?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  draft    PostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([businessId, status, scheduledFor])
  @@index([status, scheduledFor])
}

model PostingExperiment {
  id          String           @id @default(cuid())
  businessId  String
  startDate   DateTime
  dailyTarget Int
  /// [{ id: "morning" | "afternoon" | "evening", startHour, endHour }]
  windows     Json
  status      ExperimentStatus @default(RUNNING)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ─── Engagement ──────────────────────────────────────────────────────────────

/// A keyword reply rule: a comment containing one of the keywords gets a public reply and,
/// optionally, a private DM (Instagram private reply). See lib/server/keyword-replies.ts.
model EngagementRule {
  id              String           @id @default(cuid())
  businessId      String
  keywords        String[]
  /// Private DM sent to the commenter; "" for none.
  dmMessage       String
  active          Boolean          @default(true)
  timesTriggered  Int              @default(0)
  matchType       KeywordMatchType @default(WORD)
  /// Public reply under the comment; "" for none (rules made before keyword replies only had a DM).
  commentReply    String           @default("")
  scope           KeywordRuleScope @default(ALL_POSTS)
  /// Instagram media ids when scope is SELECTED_POSTS.
  mediaIds        String[]         @default([])
  /// Off: the reply waits in the Engagement approval queue instead of going out at once.
  autoSend        Boolean          @default(true)
  lastTriggeredAt DateTime?
  /// Rules only answer comments posted after they were created.
  createdAt       DateTime         @default(now())

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  triggers KeywordReplyTrigger[]
  drafts   ReplyDraft[]

  @@index([businessId])
}

/// One row per comment a keyword rule picked up: the dedupe claim (one reply per comment),
/// the 24-hour per-person cooldown, and the outcome of each send.
model KeywordReplyTrigger {
  id                String               @id @default(cuid())
  businessId        String
  ruleId            String?
  igCommentId       String
  igMediaId         String?
  /// Lower-cased username, or the Instagram-scoped id when there's no username.
  commenterKey      String
  commenterUsername String?
  commentText       String
  /// The keyword that matched.
  keyword           String
  /// "webhook" or "sync".
  source            String
  status            KeywordTriggerStatus @default(SENDING)
  /// Instagram ids of what was sent.
  replyCommentId    String?
  dmMessageId       String?
  /// Reason codes when something wasn't sent, e.g. "reply:comment_deleted dm:already_replied".
  failureReason     String?
  commentedAt       DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rule     EngagementRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([businessId, igCommentId])
  @@index([businessId, ruleId, commenterKey, createdAt])
}

model ReplyDraft {
  id                 String           @id @default(cuid())
  businessId         String
  channel            ReplyChannel     @default(COMMENT)
  /// COMMENT: the Instagram comment id. DM: the id (mid) of the first message the draft answers.
  commentId          String
  /// COMMENT: the comment. DM: the customer's message(s) since the last reply.
  commentText        String
  commenterUsername  String
  commenterAvatarUrl String?
  draftReply         String
  status             ReplyDraftStatus @default(PENDING)
  reviewedBy         String?
  createdAt          DateTime         @default(now())
  /// DM only: the customer's Instagram-scoped id (IGSID), the reply's recipient.
  recipientId        String?
  /// DM only: when the customer last wrote. Instagram accepts replies for 24 hours after it.
  lastMessageAt      DateTime?
  /// Keyword replies waiting for approval: the rule, and the private DM to send with the public reply.
  ruleId             String?
  privateReply       String?
  /// Keyword replies: when the comment was posted (private replies are accepted for 7 days).
  commentedAt        DateTime?
  /// What the AI (or the keyword rule) proposed, kept when the business edits the reply; the latest regenerated draft.
  aiReply            String?
  /// Set when the reply is sent: as drafted, edited, or written by the business.
  outcome            ReplyOutcome?
  sentAt             DateTime?
  /// "Regenerate" requests for this draft.
  regenerations      Int              @default(0)

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer User?           @relation("ReplyReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  rule     EngagementRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([businessId, commentId])
  @@index([businessId, status, createdAt])
  @@index([businessId, channel, recipientId, status])
  @@index([businessId, status, sentAt])
}

/// Instagram direct messages received through the messaging webhook (and the business's own, as echoes).
model InstagramDirectMessage {
  id           String   @id @default(cuid())
  businessId   String
  /// Meta's message id (mid); webhooks can be delivered more than once.
  igMessageId  String
  /// The customer's Instagram-scoped id (IGSID) — the other side of the conversation.
  customerId   String
  customerUsername String?
  /// True for messages the business sent (webhook echoes, or replies sent from the app).
  fromBusiness Boolean  @default(false)
  /// Text, or a short placeholder such as "[attachment]" for media.
  text         String
  sentAt       DateTime
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, igMessageId])
  @@index([businessId, customerId, sentAt])
}

// ─── Security & audit ────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the token sent by email. The raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Same pattern as PasswordResetToken: only the SHA-256 of the emailed token is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  /// Null for platform-wide events.
  businessId String?
  /// Who did it. Kept nullable so the audit trail survives user deletion.
  userId     String?
  /// Dotted action name, e.g. "permissions.updated", "reply.approved".
  action     String
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([createdAt])
}

// ─── AI assistant ────────────────────────────────────────────────────────────

/// A chat with the AI assistant. History belongs to the business (any of its users can continue it).
model AssistantConversation {
  id         String   @id @default(cuid())
  businessId String
  /// Who started it. Kept nullable so the chat survives user deletion.
  userId     String?
  /// The first question, shortened.
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AssistantMessage[]

  @@index([businessId, updatedAt])
}

/// One question or answer. Only answered turns are stored: when the AI is unavailable
/// neither the question nor an answer is saved, so the history never holds a fake reply.
model AssistantMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AssistantRole
  mode           AssistantMode
  content        String
  /// "en" | "ar": the language the user wrote in (the answer uses it too).
  language       String
  createdAt      DateTime      @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── AI strategy recommendations ─────────────────────────────────────────────

/// One analysis of a business (weekly cron or manual refresh). `inputHash` covers the data,
/// past decisions and prompt version: an unchanged hash reuses the last results (`unchanged`,
/// no AI call, no recommendations of its own).
model RecommendationRun {
  id         String                @id @default(cuid())
  businessId String
  trigger    RecommendationTrigger
  inputHash  String
  unchanged  Boolean               @default(false)
  /// Who asked for a manual refresh.
  userId     String?
  createdAt  DateTime              @default(now())

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([businessId, createdAt])
}

/// A concrete action with its rationale (both languages), confidence and the posts it rests on.
/// The owner marks it Accepted, Dismissed or Done; Done stores the metrics before (`baseline`)
/// and, 7 days later, the comparison (`outcome`).
model Recommendation {
  id           String                   @id @default(cuid())
  businessId   String
  runId        String
  actionEn     String
  actionAr     String
  rationaleEn  String
  rationaleAr  String
  /// content | timing | format | engagement | hashtags | competitors
  category     String
  /// The metric the outcome is measured on: reach | interactions | followers.
  metric       String
  confidence   RecommendationConfidence
  basedOnPosts Int
  status       RecommendationStatus     @default(NEW)
  statusAt     DateTime?
  statusBy     String?
  baseline     Json?
  outcome      Json?
  outcomeAt    DateTime?
  createdAt    DateTime                 @default(now())

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  run      RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([runId])
}

// ─── Notifications and weekly reports ────────────────────────────────────────

/// One notification for one user (read state is per person). `type` is a key of
/// lib/notifications.ts; the text is rendered from `params` in the user's language.
/// `dedupeKey` keeps one live row per recurring subject (e.g. "replies_waiting"): a new event
/// updates that row instead of adding another. In-app only for now; `emailedAt` is for the
/// email channel when it is added.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  type       String
  params     Json      @default("{}")
  href       String
  dedupeKey  String?
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

/// A week's numbers vs the week before (computed in code, lib/services/text/report.ts) and a
/// short AI summary in English and Arabic (null when the AI was unavailable: the report is
/// published with numbers only).
model WeeklyReport {
  id          String   @id @default(cuid())
  businessId  String
  periodStart DateTime
  periodEnd   DateTime
  numbers     Json
  summaryEn   String?
  summaryAr   String?
  /// ok | unavailable (no AI summary this time)
  aiStatus    String
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
