# Copy to `.env` and fill in. Never commit `.env`.
# Every variable the app reads is listed here. "Secret" = keep out of code, logs and chat; in Kubernetes it
# goes in the lge-secrets Secret, everything else in the lge-config ConfigMap (DEPLOY-DIGITALOCEAN.md).

# ── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Change host/port if you use your own PostgreSQL.
# The app always connects with DATABASE_URL (on Neon: the POOLED "-pooler" URL).
DATABASE_URL="postgresql://lge:lge@localhost:5432/local_growth_engine?schema=public"
# Prisma CLI (migrations) only. On Neon: the DIRECT (non-pooled) URL. Leave unset
# locally — the CLI then uses DATABASE_URL. See DEPLOY.md.
# DIRECT_URL=""

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Signs and encrypts the session cookie. Generate with: npx auth secret
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Public URL of the app. Used for password-reset links and Auth.js callbacks.
AUTH_URL="http://localhost:3000"

# ── Encryption ──────────────────────────────────────────────────────────────
# 32-byte key (base64) for AES-256-GCM encryption of Instagram tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# ── Services (swap the mock/local implementations without touching routes) ──
# Instagram: flow for NEW connections — "mock" (demo) or "meta" (Facebook Login, see the Meta section below).
INSTAGRAM_PROVIDER="mock"
# AI captions, reply drafts and the brand profile: "mock" (templates, no API calls)
# or "gemini" (Gemini text model with GEMINI_API_KEY; falls back to the templates
# and logs the reason to the integration log when the model can't answer).
AI_PROVIDER="mock"
# Post Generator images: "mock" (placeholder in the brand colours, no API calls) or "gemini".
IMAGE_PROVIDER="mock"
# Google AI Studio key for IMAGE_PROVIDER="gemini" and AI_PROVIDER="gemini" (server-side only; never logged). The fallback: an admin can save a platform key (and per-client keys) in the admin panel, which win over this.
GEMINI_API_KEY=""
# Optional: Gemini image model (default gemini-3.1-flash-image).
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
# Optional: Gemini text model for AI_PROVIDER="gemini" (default gemini-3.5-flash-lite, on the free tier).
# GEMINI_TEXT_MODEL="gemini-3.5-flash-lite"
# Optional: our own text request budgets per server instance, under the free tier of the default model
# (15 requests/minute, 500/day; the day resets at midnight Pacific). Raise both on a paid plan.
# GEMINI_TEXT_RPM="12"
# GEMINI_TEXT_RPD="450"
# Optional, tests only: point the Gemini client at a local stub (never in production).
# GEMINI_API_BASE=""
# File storage: "local" writes to UPLOAD_DIR (development, one server);
# "vercel-blob" stores files in a PUBLIC Vercel Blob store (production on Vercel);
# "spaces" stores them in a PRIVATE DigitalOcean Spaces bucket (Kubernetes, see DEPLOY-DIGITALOCEAN.md).
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
# For STORAGE_PROVIDER="vercel-blob": added automatically when you connect a Blob
# store to the Vercel project. Secret — never commit it.
# BLOB_READ_WRITE_TOKEN=""
# Vercel Blob with OIDC instead of a token (set by Vercel).
# BLOB_STORE_ID=""
# For STORAGE_PROVIDER="spaces": the region endpoint, region, bucket and an access key pair for it.
# SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
# SPACES_REGION="fra1"
# SPACES_BUCKET=""
# SPACES_KEY=""                 # secret
# SPACES_SECRET=""              # secret
# Optional: how long signed file links stay valid, in seconds (default 600).
# SPACES_URL_TTL="600"
# Local testing against MinIO only (docker-compose.prod.yml): path-style URLs, and the address the
# browser uses when it differs from the server's.
# SPACES_FORCE_PATH_STYLE="false"
# SPACES_PUBLIC_ENDPOINT=""
# Rate limits (logins, AI calls, uploads) and the Gemini request budget: "memory" keeps counters in this
# process (one server, or per serverless instance on Vercel — best effort, see DEPLOY.md); "redis" shares
# them through Redis / Valkey across instances (Kubernetes), falling back to memory while Redis is down.
RATE_LIMIT_STORE="memory"
# For RATE_LIMIT_STORE="redis": e.g. rediss://default:<password>@<host>:25061. Secret.
# REDIS_URL=""
# Long tasks: unset = in the request that asked for them, finished after the response (Vercel, local);
# "worker" = a separate worker deployment picks them up (Kubernetes: "Post now" is published by the worker).
# BACKGROUND_MODE=""
# Docker image only (set in the Dockerfile): build the self-contained server. Leave unset elsewhere.
# NEXT_OUTPUT="standalone"

# ── Demo ────────────────────────────────────────────────────────────────────
# Show the "Demo accounts" note (with passwords) on the login page. Set to "false" in production.
DEMO_ACCOUNTS_ENABLED="true"

# ── Meta / Instagram (Instagram API with Facebook Login) ────────────────────
# App created in Meta for Developers ("Facebook Login for Business").
# INSTAGRAM_PROVIDER above picks how "Connect Instagram" works for NEW connections:
#   "mock" — demo flow (approved at once, mock data)   "meta" — real Facebook Login
# Businesses keep the provider they connected with, so seeded demo businesses stay on mock data.
META_APP_ID=""
# App secret: Meta for Developers → App settings → Basic. Never commit, print or share it.
# While empty, Meta features stay disabled (a warning is shown when the server starts).
META_APP_SECRET=""
# Must match a "Valid OAuth Redirect URI" in the app's Facebook Login for Business settings.
# Production: https://<your-domain>/api/integrations/instagram/callback
META_REDIRECT_URI="http://localhost:3000/api/integrations/instagram/callback"
# Graph API version (https://developers.facebook.com/docs/graph-api/changelog).
META_GRAPH_VERSION="v26.0"
# Optional, tests only: another Graph API host (default https://graph.facebook.com).
# META_GRAPH_BASE_URL=""
# Optional: "token" switches to Business Login's fragment mode if the code flow is refused (default "code").
# META_OAUTH_RESPONSE_TYPE="code"
# Instagram DM webhooks (/api/webhooks/instagram): any long random string. Enter the SAME value as
# "Verify token" in Meta for Developers → Webhooks → Instagram. Deliveries are verified with META_APP_SECRET.
# While empty, Meta's verification handshake is refused. Local DMs: `npm run simulate-dm` (scripts/simulate-dm.ts).
# META_WEBHOOK_VERIFY_TOKEN=""

# ── Scheduled publishing ─────────────────────────────────────────────────────
# GET /api/cron/publish publishes queued posts whose time has come. It needs
# `Authorization: Bearer <CRON_SECRET>` and is off while this is empty
# ("Publish now" works either way). Real publishing needs a Meta connection and
# STORAGE_PROVIDER="vercel-blob" (public links) or "spaces" (signed links): Instagram downloads the image itself.
# Secret. The same value for the cron routes on Vercel / cron-job.org and the Kubernetes CronJobs + worker.
# CRON_SECRET=""
# The same secret runs GET /api/cron/daily (scheduled in vercel.json): reconnect alerts,
# weekly reports and weekly AI recommendations. Optional: AI calls per run for each (default 10).
# REPORTS_CRON_BATCH="10"
# RECOMMENDATIONS_CRON_BATCH="10"
# Optional: AI competitor comparisons per daily run (default 10) and post-monitoring readings per run (default 100).
# COMPETITOR_CRON_BATCH="10"
# MONITOR_CRON_BATCH="100"

# ── create-admin (npm run create-admin, see DEPLOY.md) ──────────────────────
# Optional: set these in your shell for ONE run instead of being prompted.
# Never put a real password in this file or in .env.
# ADMIN_EMAIL=""
# ADMIN_NAME=""
# ADMIN_PASSWORD=""

# ── Tests only (never in production) ────────────────────────────────────────
# E2E_PORT="3001"  E2E_BROWSER_CHANNEL="chrome"  E2E_AI_PROVIDER=""  E2E_GEMINI_STUB_PORT="4010"  E2E_SERVER_STDOUT=""
# Set by Vercel (don't set them yourself): VERCEL, VERCEL_ENV. NODE_ENV is set by Next.js / the Docker image.
